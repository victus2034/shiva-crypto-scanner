//@version=6
indicator("Shiva Wick Zones - Experimental", overlay = true, max_boxes_count = 100)

// This experimental version uses the confirmed pivot candle's wick as the zone.
swingLength = input.int(10, "Swing length", minval = 1, maxval = 50)
historyToKeep = input.int(20, "Zones to keep per side", minval = 1, maxval = 50)
atrPeriod = input.int(50, "ATR period", minval = 1)
overlapAtr = input.float(1.0, "Overlap filter (ATR)", minval = 0.0, step = 0.25)
minWickAtr = input.float(0.15, "Minimum wick size (ATR)", minval = 0.0, step = 0.05)
minWickToBody = input.float(1.5, "Minimum wick/body ratio", minval = 0.0, step = 0.25)
minDepartureAtr = input.float(0.75, "Minimum departure move (ATR)", minval = 0.0, step = 0.25)
zonePaddingAtr = input.float(0.25, "Zone size padding (ATR)", minval = 0.0, step = 0.05)

demandColor = color.new(color.aqua, 72)
supplyColor = color.new(color.orange, 72)
brokenColor = color.new(color.gray, 88)

var box[] demandBoxes = array.new_box()
var float[] demandTops = array.new_float()
var float[] demandBottoms = array.new_float()
var bool[] demandActive = array.new_bool()

var box[] supplyBoxes = array.new_box()
var float[] supplyTops = array.new_float()
var float[] supplyBottoms = array.new_float()
var bool[] supplyActive = array.new_bool()

atrValue = ta.atr(atrPeriod)

f_isOverlapping(float center, array<float> tops, array<float> bottoms, array<bool> active, float threshold) =>
    bool overlap = false
    if array.size(tops) > 0
        for i = 0 to array.size(tops) - 1
            if array.get(active, i)
                existingCenter = (array.get(tops, i) + array.get(bottoms, i)) / 2.0
                if math.abs(center - existingCenter) <= threshold
                    overlap := true
    overlap

f_trimZones(array<box> boxes, array<float> tops, array<float> bottoms, array<bool> active) =>
    while array.size(boxes) > historyToKeep
        oldBox = array.shift(boxes)
        box.delete(oldBox)
        array.shift(tops)
        array.shift(bottoms)
        array.shift(active)

f_addDemand(float top, float bottom, int leftIndex) =>
    center = (top + bottom) / 2.0
    if top > bottom and not f_isOverlapping(center, demandTops, demandBottoms, demandActive, atrValue * overlapAtr)
        newBox = box.new(left = leftIndex, top = top, right = bar_index, bottom = bottom, extend = extend.right, bgcolor = demandColor, border_color = color.aqua, text = "DEMAND WICK", text_color = color.black, text_size = size.small)
        array.push(demandBoxes, newBox)
        array.push(demandTops, top)
        array.push(demandBottoms, bottom)
        array.push(demandActive, true)
        f_trimZones(demandBoxes, demandTops, demandBottoms, demandActive)

f_addSupply(float top, float bottom, int leftIndex) =>
    center = (top + bottom) / 2.0
    if top > bottom and not f_isOverlapping(center, supplyTops, supplyBottoms, supplyActive, atrValue * overlapAtr)
        newBox = box.new(left = leftIndex, top = top, right = bar_index, bottom = bottom, extend = extend.right, bgcolor = supplyColor, border_color = color.orange, text = "SUPPLY WICK", text_color = color.black, text_size = size.small)
        array.push(supplyBoxes, newBox)
        array.push(supplyTops, top)
        array.push(supplyBottoms, bottom)
        array.push(supplyActive, true)
        f_trimZones(supplyBoxes, supplyTops, supplyBottoms, supplyActive)

pivotLow = ta.pivotlow(low, swingLength, swingLength)
pivotHigh = ta.pivothigh(high, swingLength, swingLength)
postPivotHighestClose = ta.highest(close, swingLength)
postPivotLowestClose = ta.lowest(close, swingLength)

if not na(pivotLow) and not na(atrValue[swingLength])
    // Demand wick, expanded by padding around the original wick/body edges.
    padding = atrValue[swingLength] * zonePaddingAtr
    demandBottom = low[swingLength] - padding
    demandTop = math.min(open[swingLength], close[swingLength]) + padding
    demandWickSize = demandTop - demandBottom
    demandBodySize = math.abs(close[swingLength] - open[swingLength])
    demandDeparture = postPivotHighestClose - demandTop
    demandStrongWick = demandWickSize >= math.max(demandBodySize * minWickToBody, syminfo.mintick)
    if demandWickSize >= atrValue[swingLength] * minWickAtr and demandStrongWick and demandDeparture >= atrValue[swingLength] * minDepartureAtr
        f_addDemand(demandTop, demandBottom, bar_index - swingLength)

if not na(pivotHigh) and not na(atrValue[swingLength])
    // Supply wick, expanded by padding around the original wick/body edges.
    padding = atrValue[swingLength] * zonePaddingAtr
    supplyBottom = math.max(open[swingLength], close[swingLength]) - padding
    supplyTop = high[swingLength] + padding
    supplyWickSize = supplyTop - supplyBottom
    supplyBodySize = math.abs(close[swingLength] - open[swingLength])
    supplyDeparture = supplyBottom - postPivotLowestClose
    supplyStrongWick = supplyWickSize >= math.max(supplyBodySize * minWickToBody, syminfo.mintick)
    if supplyWickSize >= atrValue[swingLength] * minWickAtr and supplyStrongWick and supplyDeparture >= atrValue[swingLength] * minDepartureAtr
        f_addSupply(supplyTop, supplyBottom, bar_index - swingLength)

if array.size(demandBoxes) > 0
    for i = array.size(demandBoxes) - 1 to 0
        if array.get(demandActive, i) and close <= array.get(demandBottoms, i)
            array.set(demandActive, i, false)
            brokenBox = array.get(demandBoxes, i)
            box.set_extend(brokenBox, extend.none)
            box.set_right(brokenBox, bar_index)
            box.set_bgcolor(brokenBox, brokenColor)
            box.set_border_color(brokenBox, color.gray)
            box.set_text(brokenBox, "")

if array.size(supplyBoxes) > 0
    for i = array.size(supplyBoxes) - 1 to 0
        if array.get(supplyActive, i) and close >= array.get(supplyTops, i)
            array.set(supplyActive, i, false)
            brokenBox = array.get(supplyBoxes, i)
            box.set_extend(brokenBox, extend.none)
            box.set_right(brokenBox, bar_index)
            box.set_bgcolor(brokenBox, brokenColor)
            box.set_border_color(brokenBox, color.gray)
            box.set_text(brokenBox, "")
